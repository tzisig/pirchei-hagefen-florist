---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { site, contact, legal } from '../config/site.config';
import { breadcrumbSchema, home } from '../lib/schema';
import { formatDate, telLink } from '../lib/util';

const crumbs = [home, { label: 'הצהרת נגישות', href: '/accessibility/' }];
---
<BaseLayout title="הצהרת נגישות" description={`הצהרת הנגישות של אתר ${site.name}: רמת הנגישות, מה עשינו באתר ובחנות, ופרטי רכזת הנגישות.`} schema={[breadcrumbSchema(crumbs)]}>
  <PageHead crumbs={crumbs} title="הצהרת נגישות" lead={`עודכן לאחרונה: ${formatDate(site.updated)}`} />
  <section class="section">
    <div class="wrap prose">
      <p>אנחנו רוצים שכל אחד יוכל להזמין מאיתנו פרחים, כולל אנשים עם מוגבלות. האתר נבנה כך שיהיה נגיש, בהתאם לתקנות שוויון זכויות לאנשים עם מוגבלות (התאמות נגישות לשירות), התשע"ג-2013.</p>

      <h2>רמת הנגישות</h2>
      <p>האתר נבנה בהתאם לתקן הישראלי ת"י 5568, המבוסס על הנחיות WCAG 2.0 ברמה AA.</p>

      <h2>מה עשינו באתר</h2>
      <ul>
        <li>ניווט מלא במקלדת, כולל התפריט, סינון הקטלוג, בונה הזרים, בודק המשלוח, שאלות נפוצות וטפסים, עם סימון ברור של הרכיב הפעיל.</li>
        <li>קישור "דלגו לתוכן הראשי" בתחילת כל עמוד.</li>
        <li>ניגודיות צבעים לפי דרישות רמה AA.</li>
        <li>מבנה כותרות היררכי, תיאור טקסטואלי לתמונות משמעותיות ותוויות לכל שדות הטופס.</li>
        <li>לוח העונות בנוי כטבלה עם כותרות, וכל תא מוקרא כ"זמין" או "לא זמין" בחודש.</li>
        <li>סימוני הפרחים בתמונה הראשית הם קישורים עם טקסט, ולא רק סמלים גרפיים.</li>
        <li>התאמה לכל גדלי המסך ואפשרות הגדלת טקסט עד 200% בלי אובדן תוכן.</li>
        <li>כיבוד הגדרת "הפחתת תנועה" של מערכת ההפעלה.</li>
        <li>הנגישות מובנית בקוד האתר ואינה נשענת על תוסף נגישות חיצוני.</li>
      </ul>

      <h2>נגישות החנות והשירות</h2>
      <p>הכניסה לחנות בבקעה היא ממפלס הרחוב. אפשר להזמין בטלפון, בוואטסאפ (בהודעה כתובה או קולית), במייל או בטופס באתר, ואפשר לבקש שנביא את הזר עד הרכב.</p>

      <h2>נתקלתם בבעיה?</h2>
      <p>אם מצאתם רכיב שאינו נגיש, נשמח לדעת ולתקן. פרטי רכזת הנגישות:</p>
      <ul>
        <li>שם: {legal.accessibilityCoordinator}</li>
        <li>טלפון: <a href={telLink} dir="ltr">{contact.phone}</a></li>
        <li>מייל: <a href={`mailto:${legal.accessibilityEmail}`}>{legal.accessibilityEmail}</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
