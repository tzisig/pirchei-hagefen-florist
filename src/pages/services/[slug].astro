---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import FaqList from '../../components/FaqList.astro';
import BouquetCard from '../../components/BouquetCard.astro';
import ContactForm from '../../components/ContactForm.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services, bouquets, site, type Service } from '../../config/site.config';
import { breadcrumbSchema, faqSchema, businessRef, home } from '../../lib/schema';
import { price, waLink } from '../../lib/util';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}
interface Props { service: Service }
const { service: s } = Astro.props;

const crumbs = [home, { label: 'שירותים', href: '/services/' }, { label: s.title, href: `/services/${s.slug}/` }];
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.title,
  description: s.intro,
  provider: businessRef,
  areaServed: { '@type': 'City', name: 'ירושלים' },
  url: `${site.url}/services/${s.slug}/`,
  offers: { '@type': 'Offer', priceSpecification: { '@type': 'PriceSpecification', minPrice: s.priceFrom, priceCurrency: 'ILS' } },
};
// Gift bouquets show three catalog examples
const examples = s.slug === 'gift-bouquets' ? bouquets.slice(6, 9) : [];
const others = services.filter((o) => o.slug !== s.slug);
---
<BaseLayout
  title={`${s.title} | ${s.keyword}`}
  description={`${s.short} ${s.title} בירושלים, מ-${price(s.priceFrom)} ${s.priceUnit}.`}
  schema={[breadcrumbSchema(crumbs), serviceSchema, faqSchema(s.faq)]}
  ogImage={s.image}
>
  <PageHead crumbs={crumbs} title={s.title} lead={s.intro} image={s.image} imageAlt={s.imageAlt}>
    <p class="price">מ-{price(s.priceFrom)} {s.priceUnit}, כולל מע"מ</p>
    <div class="actions">
      <a class="btn btn--wa" href={waLink(`שלום נועה, אשמח לשמוע על ${s.title}`)} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} />שאלה בוואטסאפ</a>
      <a class="btn btn--ghost" href="#form">השאירו פרטים</a>
    </div>
  </PageHead>

  <section class="section">
    <div class="wrap cols">
      <div>
        <h2>{s.whenTitle}</h2>
        <ul class="ticks">{s.when.map((w) => <li><Icon name="leaf" size={18} />{w}</li>)}</ul>
      </div>
      <div>
        <h2>{s.includesTitle}</h2>
        <ul class="ticks">{s.includes.map((w) => <li><Icon name="check" size={18} />{w}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section section--blush">
    <div class="wrap">
      <h2 class="h-steps">איך זה עובד</h2>
      <ol class="steps">
        {s.steps.map((st) => <li><h3>{st.title}</h3><p>{st.text}</p></li>)}
      </ol>
    </div>
  </section>

  {examples.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="head"><h2>כמה זרים מהקטלוג</h2><p><a href="/bouquets/">לכל 12 הזרים</a></p></div>
        <div class="examples">{examples.map((b) => <BouquetCard bouquet={b} />)}</div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap cols">
      <div>
        <h2>שאלות על {s.title}</h2>
        <FaqList items={s.faq} />
      </div>
      <div id="form" class="form-box">
        <h2>נחזור אליכם</h2>
        <ContactForm topic={s.formTopic} id="svc" />
      </div>
    </div>
  </section>

  <section class="section section--blush">
    <div class="wrap">
      <h2 class="h-other">עוד שירותים</h2>
      <ul class="others">
        {others.map((o) => <li><a href={`/services/${o.slug}/`}>{o.title}</a><span>{o.short}</span></li>)}
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .price { font-family: var(--font-sans); font-weight: 600; color: var(--c-vine); }
  .cols { display: grid; gap: var(--space-7); }
  @media (min-width: 900px) { .cols { grid-template-columns: 1fr 1fr; gap: var(--space-8); } }
  .cols h2 { font-size: var(--step-3); margin-bottom: var(--space-5); }
  .ticks { list-style: none; padding: 0; display: grid; gap: var(--space-3); }
  .ticks li { display: flex; gap: var(--space-3); align-items: flex-start; font-size: 1.1rem; }
  .ticks :global(svg) { color: var(--c-vine); margin-top: 0.35rem; flex: none; }
  .h-steps, .h-other { font-size: var(--step-3); margin-bottom: var(--space-6); }
  .steps { list-style: none; padding: 0; display: grid; gap: var(--space-6); counter-reset: step; }
  @media (min-width: 760px) { .steps { grid-template-columns: repeat(4, 1fr); } }
  .steps li { counter-increment: step; border-top: 1px solid var(--c-grape); padding-top: var(--space-4); }
  .steps li::before { content: counter(step); display: block; font-size: var(--step-3); line-height: 1; color: var(--c-vine); margin-bottom: var(--space-3); }
  .steps h3 { margin-bottom: var(--space-2); }
  .examples { display: grid; gap: var(--space-5); }
  @media (min-width: 640px) { .examples { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .examples { grid-template-columns: repeat(3, 1fr); } }
  .form-box { background: #fff; border: 1px solid var(--c-line); padding: var(--space-6); align-self: start; scroll-margin-top: 8rem; }
  .others { list-style: none; padding: 0; display: grid; gap: var(--space-4); }
  @media (min-width: 760px) { .others { grid-template-columns: repeat(2, 1fr); gap: var(--space-5) var(--space-7); } }
  .others li { display: grid; gap: 0.2rem; }
  .others a { font-size: var(--step-1); color: var(--c-grape); }
  .others span { color: var(--c-muted); font-size: 1rem; }
</style>
