---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import DeliveryStatus from './DeliveryStatus.astro';
import { contact } from '../config/site.config';
import { nav } from '../config/navigation';
import { waLink, telLink } from '../lib/util';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<aside class="strip on-dark" aria-label="מצב המשלוחים היום">
  <div class="wrap"><DeliveryStatus /></div>
</aside>
<header class="header" data-header>
  <div class="wrap bar">
    <Logo />
    <nav class="nav" aria-label="ניווט ראשי">
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="tools">
      <a class="phone" href={telLink} dir="ltr"><Icon name="phone" size={17} /><span>{contact.phone}</span></a>
      <a class="btn btn--wa wa" href={waLink()} target="_blank" rel="noopener"><Icon name="whatsapp" size={19} />הזמנה בוואטסאפ</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
        <Icon name="menu" size={24} />
        <span class="visually-hidden">תפריט</span>
      </button>
    </div>
  </div>
  <nav class="mobile-nav" id="mobile-nav" aria-label="ניווט ראשי" hidden data-mobile-nav>
    <ul class="wrap">
      <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>דף הבית</a></li>
      {nav.map((n) => (
        <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
      ))}
      <li><a href="/areas/">אזורי משלוח</a></li>
      <li><a href="/gallery/">גלריית אירועים</a></li>
      <li><a href="/reviews/">המלצות</a></li>
      <li><a href="/faq/">שאלות נפוצות</a></li>
    </ul>
  </nav>
</header>

<style>
  .strip { background: var(--c-grape-deep); padding-block: 0.45rem; }
  .header { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--c-paper) 94%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid transparent; transition: border-color 0.2s; }
  .header:global(.is-scrolled) { border-bottom-color: var(--c-line); }
  .bar { display: flex; align-items: center; gap: var(--space-5); min-height: 72px; }
  .nav { margin-inline: auto; display: none; }
  .nav ul { display: flex; gap: 1.4rem; list-style: none; padding: 0; }
  .nav a, .mobile-nav a { font-family: var(--font-sans); font-size: 0.95rem; font-weight: 500; color: var(--c-text); text-decoration: none; padding-block: 0.4rem; border-bottom: 1.5px solid transparent; }
  .nav a:hover, .nav a[aria-current='page'] { border-bottom-color: var(--c-vine); color: var(--c-vine); }
  .tools { display: flex; align-items: center; gap: var(--space-3); margin-inline-start: auto; }
  .phone { display: none; align-items: center; gap: 0.4rem; font-family: var(--font-sans); font-weight: 600; color: var(--c-grape); text-decoration: none; white-space: nowrap; }
  .wa { display: none; min-height: 44px; padding-inline: 1.1rem; font-size: 0.95rem; }
  .menu-toggle { display: grid; place-items: center; width: 48px; height: 48px; border: 0; background: none; color: var(--c-grape); cursor: pointer; border-radius: 50%; }
  .mobile-nav { border-top: 1px solid var(--c-line); background: var(--c-paper); max-height: calc(100dvh - 110px); overflow-y: auto; }
  .mobile-nav ul { list-style: none; padding-block: var(--space-4) var(--space-6); display: grid; }
  .mobile-nav a { display: block; font-family: var(--font-serif); font-size: 1.5rem; font-weight: 400; padding-block: 0.55rem; }
  .mobile-nav a[aria-current='page'] { color: var(--c-vine); }
  @media (min-width: 640px) { .wa { display: inline-flex; } }
  @media (min-width: 1180px) {
    .nav { display: block; }
    .menu-toggle { display: none; }
    .mobile-nav { display: none; }
    .tools { margin-inline-start: 0; }
  }
  @media (min-width: 1320px) { .phone { display: inline-flex; } }
</style>
