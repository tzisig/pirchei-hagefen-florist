---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details>
      <summary><span>{f.q}</span><span class="sign" aria-hidden="true"></span></summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--c-line); }
  details { border-bottom: 1px solid var(--c-line); }
  summary { display: flex; justify-content: space-between; gap: var(--space-4); align-items: center; padding-block: var(--space-4); cursor: pointer; list-style: none; font-size: var(--step-1); line-height: 1.4; color: var(--c-grape); }
  summary::-webkit-details-marker { display: none; }
  .sign { position: relative; width: 14px; height: 14px; flex: none; }
  .sign::before, .sign::after { content: ''; position: absolute; inset: 6px 0 auto; height: 2px; background: currentColor; transition: transform 0.2s var(--ease); }
  .sign::after { transform: rotate(90deg); }
  details[open] .sign::after { transform: rotate(0deg); }
  details p { padding-bottom: var(--space-5); max-width: 44rem; }
</style>
