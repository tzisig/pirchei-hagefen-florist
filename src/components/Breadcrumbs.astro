---
import type { Crumb } from '../lib/schema';
interface Props { crumbs: Crumb[] }
const { crumbs } = Astro.props;
---
<nav aria-label="פירורי לחם" class="crumbs">
  <ol>
    {crumbs.map((c, i) => (
      <li>
        {c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.3rem 0; list-style: none; padding: 0; font-family: var(--font-sans); font-size: 0.875rem; color: var(--c-muted); }
  .crumbs li + li::before { content: '/'; margin-inline: 0.5rem; color: var(--c-line); }
  .crumbs a { color: var(--c-muted); }
  .crumbs [aria-current] { color: var(--c-text); }
</style>
